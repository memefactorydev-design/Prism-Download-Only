# ─── Prism AI — environment template ────────────────────────────────────────
# `npm run setup` copies this to .env and fills in the generated secrets.
# .env is gitignored — NEVER commit real values. Service API keys can also be
# entered on the app's /connections page (stored encrypted in the database).

# Database.
#  • Local dev: a SQLite file (better-sqlite3).
DATABASE_URL="file:./dev.db"
#  • Serverless (Vercel etc.): a file DB can't be written on read-only serverless
#    filesystems — use Turso (serverless SQLite, same provider). Set these two and
#    leave DATABASE_URL unset in that environment. Create a DB at turso.tech.
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""

# 32-byte hex key for encrypting stored OAuth tokens at rest (AES-256-GCM).
# Generate with:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=""

# Password for logging into the dashboard (single user). Pick something strong.
DASHBOARD_PASSWORD=""

# ─── AI engine ──────────────────────────────────────────────────────────────
# Every agent, writer and planner runs on ONE engine. Nothing here needs API
# credits: sign in to a CLI you already pay for and Prism drives it locally.
#
#   claude-cli     Claude Code (`npm i -g @anthropic-ai/claude-code`, then
#                  `claude auth login`) — bills your Claude Pro/Max plan.
#   codex-cli      OpenAI Codex (`npm i -g @openai/codex`, then `codex login`)
#                  — bills your ChatGPT Plus/Pro plan.
#   anthropic-api  The pay-per-token API with the key below (optional).
#
# "auto" (default) prefers an API key if one is connected, then Claude Code,
# then Codex. The /connections page shows what it found and lets you switch.
# Subscription engines count every agent run against your plan's usage window.
LLM_ENGINE="auto"
# Paths, only if the CLIs aren't on the app's PATH.
# CLAUDE_BIN="/usr/local/bin/claude"
# CODEX_BIN="/usr/local/bin/codex"
# Model per quality tier on Claude Code (aliases or full names). Set all three
# to "sonnet" to stretch a Pro plan.
# CLAUDE_CLI_MODEL_OPUS="opus"
# CLAUDE_CLI_MODEL_SONNET="sonnet"
# CLAUDE_CLI_MODEL_HAIKU="haiku"
# Codex model (defaults to the `model` in ~/.codex/config.toml, else Codex's own
# default) and a cheaper one for the lighter tiers.
# CODEX_MODEL="gpt-5.5"
# CODEX_MODEL_FAST=""
# CODEX_REASONING_EFFORT="medium"
# Per-call ceiling and how many CLI sessions may run at once.
LLM_TIMEOUT_MS="600000"
LLM_MAX_CONCURRENCY="2"
# Nightly dreams per night on a subscription engine (unlimited on the API).
DREAMS_MAX_PER_NIGHT="8"

# Optional: Anthropic API key (pay-per-token). Create at https://console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=""

# ─── Postiz (single posting core: IG, FB, TikTok, LinkedIn, YouTube, Pinterest, Google Business) ────
# Create an account at https://postiz.com, connect your social channels there,
# then generate an API key in Postiz settings.
POSTIZ_API_KEY=""
# Default is Postiz cloud; change if self-hosting.
POSTIZ_API_URL="https://api.postiz.com/public/v1"

# ─── Meta (Facebook/Instagram ads + Ad Library research) ───────────────────
# Create an app at https://developers.facebook.com → My Apps → Create App (Business type).
# NOTE: live campaign creation needs ads_management permission + Meta App Review.
# Reading insights and the public Ad Library works sooner. The app tracks this
# as a connection status — it will tell you what is and isn't unlocked yet.
META_APP_ID=""
META_APP_SECRET=""
# Long-lived user/system-user access token (the setup wizard explains generation).
META_ACCESS_TOKEN=""
# Your ad account id, numeric part only (no "act_" prefix).
META_AD_ACCOUNT_ID=""

# ─── Apify (Studio trend research: TikTok + Instagram + YouTube + LinkedIn + Pinterest + Facebook ads) ─
# Powers Studio's viral-trend scraping. NOTE: scrapes those platforms (subject
# to their ToS) and Apify runs cost credits. Create at apify.com → Settings → API.
APIFY_TOKEN=""
# Override the scraper actors if yours differ (owner/actor or owner~actor form).
APIFY_TIKTOK_ACTOR="clockworks/tiktok-scraper"
APIFY_INSTAGRAM_ACTOR="apify/instagram-scraper"
APIFY_YOUTUBE_ACTOR="streamers/youtube-scraper"
# LinkedIn: harvestapi/linkedin-profile-posts scrapes recent POSTS from the
# profile/company URLs (or bare handles) you enter in the LinkedIn research box.
APIFY_LINKEDIN_ACTOR="harvestapi/linkedin-post-search"
APIFY_PINTEREST_ACTOR="fatihtahta/pinterest-scraper-search"
APIFY_FACEBOOK_ACTOR="apify/facebook-ads-scraper"

# ─── WordPress (publish SEO content + built sites live) ─────────────────────
# Create an Application Password in WordPress → Users → Profile. Live pushes are
# approval-confirmed in the UI.
WORDPRESS_SITE_URL=""
WORDPRESS_USERNAME=""
WORDPRESS_APP_PASSWORD=""

# ─── FTP / SFTP (publish static sites & landing pages) ─────────────────────
FTP_PROTOCOL="sftp"           # "sftp" (port 22) or "ftp" (port 21)
FTP_HOST=""
FTP_PORT="22"
FTP_USER=""
FTP_PASSWORD=""
FTP_BASE_DIR="/public_html"   # where files upload to
FTP_PUBLIC_BASE_URL=""        # public URL that maps to FTP_BASE_DIR

# ─── Google data via Apify (SEO/GEO + GBP research) ────────────────────────
# Optional: point these at Google SERP / Google Maps scraper actors you have.
# If unset/unavailable, agents fall back to their web_search tool.
APIFY_GOOGLE_SEARCH_ACTOR="apify/google-search-scraper"
APIFY_GMAPS_ACTOR="compass/crawler-google-places"

# ─── Studio (Phase 7: video editor) ────────────────────────────────────────
# Rendering runs in a separate process: `npm run worker` (alongside `npm run dev`).
# Transcription uses ElevenLabs Scribe (word-level timestamps) via the
# elevenlabs connection — source audio is uploaded for this step.
ELEVENLABS_STT_MODEL="scribe_v2"
# Parallel ffmpeg renders. Default: (CPU cores - 1). Lower it if the box struggles.
RENDER_CONCURRENCY=""
# How often the worker polls for queued jobs, in ms (default 3000).
WORKER_POLL_MS=""
# Active-speaker reframe: on-device object-detection model (downloads once, cached)
# and the frame sampling rate for tracking. Only used when "Track speaker" is on.
DETECTION_MODEL="Xenova/yolos-tiny"
REFRAME_FPS=""
# Where Transformers.js caches downloaded models (default: ./.cache/models, gitignored).
TRANSFORMERS_CACHE=".cache/models"

# ─── Media storage ──────────────────────────────────────────────────────────
# "local" stores uploads in ./uploads (dev). "s3" uses the S3-compatible vars below.
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION=""

# ─── Named agent team (Scout, Harriet, Isla, … Lydia) ────────────────────────
# Gemini powers the agents' live Google-grounded research plus the Ad Studio's
# Nano Banana images and Veo video. Connect it on /connections, or set it here.
GEMINI_API_KEY=""
# Optional model overrides.
# GEMINI_TEXT_MODEL="gemini-2.5-pro"
# GEMINI_IMAGE_MODEL="gemini-2.5-flash-image"
# GEMINI_VIDEO_MODEL="veo-3.0-generate-001"
# Model override for named-agent chat (an API model id, or a CLI alias).
# NAMED_AGENT_MODEL=""

# Hour (0-23, local time) when agents dream — the nightly memory-consolidation
# cycle. Runs inside the worker process, so keep `npm run worker` running.
DREAM_HOUR="3"

# The business the marketing engine works for is captured on first run at
# /welcome (website + a short quiz) and editable on /brand — not configured here.

# ─── ElevenLabs (Studio voice-over narration + generated sound-effects library) ─
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_ID="" # optional default narrator voice; pick per-video in Studio otherwise

# ─── Pexels (media library "Find stock" — free photos & b-roll) ─────────────
PEXELS_API_KEY=""

# ─── fal.ai (Ad Studio alternative engines: FLUX images, Kling image-to-video) ─
FAL_KEY=""
# Seedance is the primary video engine (Veo via Gemini is the backup). The
# text-to-video variant is derived by swapping the trailing path segment.
FAL_VIDEO_MODEL="bytedance/seedance-2.0/fast/image-to-video"

# ─── Deals webhook (won-deal revenue for Spend vs Revenue on /ads) ──────────
DEALS_WEBHOOK_SECRET=""

# ─── Auth (multi-user) ───────────────────────────────────────────────────────
# OPEN_ACCESS="1" switches the login screen OFF: every visitor is signed in as a
# built-in admin ("Owner"). Use it for local evaluation or a private team server
# behind your own network/VPN. Set it to "0" (and a DASHBOARD_PASSWORD) before
# putting an instance on the public internet.
OPEN_ACCESS="1"
# With OPEN_ACCESS=0: DASHBOARD_PASSWORD doubles as the FIRST admin's password
# (seeded on first login) for the account below.
ADMIN_EMAIL="you@example.com"
ADMIN_NAME="Owner"

# ─── Dual-instance ───────────────────────────────────────────────────────────
# When two instances run (e.g. a laptop and a server), set DREAMS_ENABLED=0 on
# one of them so agent memories evolve in exactly one place.
DREAMS_ENABLED="1"

# Leads webhook (site forms / n8n → /api/leads/webhook, header x-webhook-secret)
LEADS_WEBHOOK_SECRET=
# Public base URL used in newsletter unsubscribe links
APP_BASE_URL=

# ElevenLabs TTS model for voice-overs (eleven_v3 = most natural, timestamps verified 2026-07-12).
ELEVENLABS_TTS_MODEL="eleven_v3"

# ─── Plan & quotas ───────────────────────────────────────────────────────────
# The plan this deployment is sold on (starter|growth|agency|enterprise). Sets
# the hard monthly AI-video-generation allowance shared by all members
# (10/40/120/300 — see src/lib/quota.ts). Unset = no hard cap (pre-billing).
PRISM_PLAN=""
# Bespoke deals: override the plan's video allowance with an explicit number.
VIDEO_QUOTA_OVERRIDE=""
# Generous soft ceiling on ALL metered units/month (surfaced on /usage at 80%).
USAGE_SOFT_LIMIT="600"

# ─── Iris (in-app AI guide) ──────────────────────────────────────────────────
# Model override for Iris chat (an API model id, or a CLI alias such as "sonnet").
IRIS_MODEL=""
